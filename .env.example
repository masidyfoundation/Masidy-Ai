# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FRONTEND CONFIGURATION
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Masidy AI
VITE_APP_VERSION=1.0.0

# BACKEND CONFIGURATION
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./local_db.json
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI MODEL CONFIGURATION
GROQ_API_KEY=your_groq_api_key_here
MODEL_PROVIDER=groq
DEFAULT_MODEL=masidy-pro

# SERVER CONFIGURATION
SERVER_PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# RATE LIMITING
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# SECURITY
CORS_ORIGIN=https://yourdomain.com
CSRF_PROTECTION=true
SESSION_SECRET=your_session_secret_here

# STRIPE PAYMENT INTEGRATION SECRETS (Optional - Live settings)
# Input your stripe secret key here to use real subscriptions instead of sandbox simulation.
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."
